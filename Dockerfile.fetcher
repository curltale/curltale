# The optional browser service for the Library: renders web pages that need JavaScript. It has no database, no files and no app secrets;
# its only job is to answer /render for the app (see backend/studio/fetcher.py for how it keeps the browser away from the network).
# The browser is only as safe as it is recent: bump this image and the playwright package together, often (each release carries a newer Chromium).
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble
WORKDIR /app
RUN pip install --no-cache-dir playwright==1.64.1 fastapi==0.159.1 uvicorn==0.54.0 httpx==0.28.1 pydantic==2.14.1
COPY backend/studio/library/netguard.py backend/studio/fetcher.py ./
USER pwuser
# Chromium runs INSIDE its own sandbox (docker-compose.fetcher.yml gives the container the seccomp profile that allows it). Only on a host where
# user namespaces are switched off, set FETCH_NO_SANDBOX=1 on the container: the page then runs with the container as its only wall.
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8001/health')"
CMD ["python", "fetcher.py"]
